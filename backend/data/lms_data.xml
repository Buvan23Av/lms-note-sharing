    <topics>
        <!-- DBMS Topics -->
        <topic id="T101" subjectId="SUB101">
            <name>Normalization</name>
            <description>Database normalization forms - 1NF, 2NF, 3NF, BCNF</description>
        </topic>
        <topic id="T102" subjectId="SUB101">
            <name>ER Model</name>
            <description>Entity-Relationship diagrams and modeling</description>
        </topic>
        <topic id="T103" subjectId="SUB101">
            <name>SQL Queries</name>
            <description>Structured Query Language - SELECT, JOIN, subqueries</description>
        </topic>
        <topic id="T104" subjectId="SUB101">
            <name>Transactions</name>
            <description>ACID properties, concurrency control, recovery</description>
        </topic>
        <topic id="T105" subjectId="SUB101">
            <name>Indexing</name>
            <description>B-trees, hashing, index structures</description>
        </topic>
        <topic id="T106" subjectId="SUB101">
            <name>Functional Dependency</name>
            <description>Functional dependencies, closure, canonical cover</description>
        </topic>
        
        <!-- DSA Topics -->
        <topic id="T201" subjectId="SUB102">
            <name>Arrays and Linked Lists</name>
            <description>Linear data structures - arrays, singly/doubly linked lists</description>
        </topic>
        <topic id="T202" subjectId="SUB102">
            <name>Trees and Graphs</name>
            <description>Binary trees, BST, graph traversal (BFS, DFS)</description>
        </topic>
        <topic id="T203" subjectId="SUB102">
            <name>Sorting Algorithms</name>
            <description>Bubble, merge, quick, heap sort and their complexities</description>
        </topic>
        <topic id="T204" subjectId="SUB102">
            <name>Dynamic Programming</name>
            <description>Optimal substructure, overlapping subproblems, memoization</description>
        </topic>
        
        <!-- OS Topics -->
        <topic id="T301" subjectId="SUB103">
            <name>Process Management</name>
            <description>Process states, scheduling algorithms, context switching</description>
        </topic>
        <topic id="T302" subjectId="SUB103">
            <name>Memory Management</name>
            <description>Paging, segmentation, virtual memory</description>
        </topic>
        <topic id="T303" subjectId="SUB103">
            <name>Deadlocks</name>
            <description>Deadlock prevention, avoidance, detection, recovery</description>
        </topic>
        
        <!-- CN Topics -->
        <topic id="T401" subjectId="SUB104">
            <name>OSI Model</name>
            <description>Seven layers of the OSI reference model</description>
        </topic>
        <topic id="T402" subjectId="SUB104">
            <name>TCP/IP Protocol</name>
            <description>TCP, UDP, IP addressing, routing protocols</description>
        </topic>
        
        <!-- DSP Topics -->
        <topic id="T501" subjectId="SUB105">
            <name>Fourier Transform</name>
            <description>DFT, FFT, frequency domain analysis</description>
        </topic>
    </topics>

